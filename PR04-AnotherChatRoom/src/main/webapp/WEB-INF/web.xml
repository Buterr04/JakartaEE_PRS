<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Another Chatroom</display-name>

    <!-- Session 配置（单位：分钟） -->
    <session-config>
        <session-timeout>60</session-timeout>
    </session-config>

    <!-- 应用级参数：消息上限 -->
    <context-param>
        <param-name>maxMessageCount</param-name>
        <param-value>50</param-value>
    </context-param>

    <!-- 监听器（2 个） -->
    <listener>
        <listener-class>site.buterr.pr04anotherchatroom.listener.AppInitListener</listener-class>
    </listener>
    <listener>
        <listener-class>site.buterr.pr04anotherchatroom.listener.SessionLifecycleListener</listener-class>
    </listener>

    <!-- 过滤器：编码/关键词过滤 -> 鉴权 -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>site.buterr.pr04anotherchatroom.filter.EncodingFilter</filter-class>
        <init-param>
            <param-name>charset</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>site.buterr.pr04anotherchatroom.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/chat</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/logout</url-pattern>
    </filter-mapping>

    <!-- Servlet -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>site.buterr.pr04anotherchatroom.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ChatServlet</servlet-name>
        <servlet-class>site.buterr.pr04anotherchatroom.servlet.ChatServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ChatServlet</servlet-name>
        <url-pattern>/chat</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>site.buterr.pr04anotherchatroom.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

</web-app>
